@model CampaignResultsDto?
@{
    ViewData["Title"] = "Campaign results";
}

@if (TempData["Error"] is string error)
{
    <div class="alert alert-danger">@error</div>
}

@if (Model is not null)
{
    <div class="d-flex justify-content-between align-items-end mb-3">
        <div>
            <h4 class="mb-0">@Model.Name</h4>
            <div class="text-muted small">
                @Model.StartDate.ToString("dd.MM.yyyy") – @Model.EndDate.ToString("dd.MM.yyyy")
                · @Model.DiscountPercent% discount · limit @Model.DailyLimitPerAgent per agent/day
            </div>
        </div>
    </div>

    <div class="row g-4 mb-4">
        <div class="col-md-3"><div class="card p-3"><div class="text-muted small">Eligible customers</div><div class="stat-value">@Model.TotalRewarded</div></div></div>
        <div class="col-md-3"><div class="card p-3"><div class="text-muted small">Purchased with discount</div><div class="stat-value">@Model.TotalAccepted</div></div></div>
        <div class="col-md-3"><div class="card p-3"><div class="text-muted small">Conversion rate</div><div class="stat-value">@Model.ConversionRate%</div></div></div>
        <div class="col-md-3"><div class="card p-3"><div class="text-muted small">Cancelled (agent corrections)</div><div class="stat-value">@Model.CancelledCount</div></div></div>
    </div>

    <div class="row g-4">
        <div class="col-lg-7">
            <div class="card p-4">
                <h5 class="mb-3">Agent activity</h5>
                <table class="table mb-0">
                    <thead><tr><th>Agent</th><th>Registered</th><th>Purchased</th><th>Conversion</th></tr></thead>
                    <tbody>
                        @foreach (var a in Model.AgentPerformance)
                        {
                            <tr><td>@a.AgentName</td><td>@a.Rewarded</td><td>@a.Accepted</td><td>@a.ConversionRate%</td></tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>

        <div class="col-lg-5">
            <div class="card p-4">
                <h5 class="mb-3">By day</h5>
                <table class="table mb-0">
                    <thead><tr><th>Date</th><th>Registered</th><th>Purchased</th></tr></thead>
                    <tbody>
                        @foreach (var d in Model.DailyBreakdown)
                        {
                            <tr><td>@d.Date.ToString("dd.MM.yyyy")</td><td>@d.Rewarded</td><td>@d.Accepted</td></tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
}