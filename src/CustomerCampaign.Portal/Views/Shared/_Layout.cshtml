<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Loyalty Campaign</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <style>
            body { background: #f5f6f8; }
            .card { border: none; box-shadow: 0 1px 3px rgba(0,0,0,.08); }
            .stat-value { font-size: 1.8rem; font-weight: 600; }
    </style>
</head>
<body>
    <nav class="navbar navbar-expand navbar-dark bg-dark mb-4">
        <div class="container">
            <span class="navbar-brand">Loyalty Campaign</span>

            @if (User.Identity?.IsAuthenticated == true)
            {
                <ul class="navbar-nav me-auto">
                    @if (User.IsInRole("Agent"))
                    {
                        <li class="nav-item"><a class="nav-link" asp-controller="Home" asp-action="Index">My day</a></li>
                    }
                    @if (User.IsInRole("Admin"))
                    {
                        <li class="nav-item"><a class="nav-link" asp-controller="Home" asp-action="Results">Campaign results</a></li>
                    }
                </ul>

                <span class="navbar-text text-light me-3">
                    @User.Identity.Name
                    <span class="badge bg-secondary ms-1">@User.FindFirst(System.Security.Claims.ClaimTypes.Role)?.Value</span>
                </span>

                <form asp-controller="Account" asp-action="Logout" method="post" class="d-inline">
                    <button type="submit" class="btn btn-outline-light btn-sm">Log out</button>
                </form>
            }
        </div>
    </nav>

    <main class="container pb-5">
        @RenderBody()
    </main>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>